# Public (browser-safe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=

# Redis (черги; опційно спільний з auto-script-v2)
REDIS_URL=

# Union → auto-script-v2: webhook після генерації / артефакту.
# auto-script-v2: лише Yandex Вебмайстер + верифікація SSL-сертифіката для нових доменів на хості.
# Закупівля домену та первинна SSL — у Union (не в auto-script).
AUTOSCRIPT_WEBHOOK_URL=
AUTOSCRIPT_WEBHOOK_SECRET=

# --- Генератор (двигун у цьому репо: src/lib/generator-engine) ---
# Мінімум один ключ Anthropic (sk-ant-…) або ключ локального проксі (sk-…) + ANTHROPIC_BASE_URL
# ANTHROPIC_BASE_URL=http://localhost:3001
CLAUDE_API_KEY_01=
# Дефолты Union (src/instrumentation.ts, если переменные не заданы в .env):
# SOFTGEN_REQUIRE_REFERENCE_STRUCTURE=0
# SOFTGEN_REFERENCE_TEMPLATE_MODE=1
# SOFTGEN_DUAL_SITE_TEMPLATES=1
# Эталоны в Supabase (таблицы generation_site_templates / generation_site_template_assets):
#   node scripts/seed-generation-site-templates.mjs
# SOFTGEN_ETALON_SOURCE=auto   — supabase, при пустой БД fallback на FS (auto|supabase|filesystem)
# SOFTGEN_ETALON_BET162_PATH=/Users/you/u-bet162
# SOFTGEN_ETALON_SPOT064_PATH=/Users/you/u-spot064
# API: GET /api/generator/site-templates, GET /api/generator/site-templates/bet162?kind=css
# Свободная генерация (без подгонки под прошлые сайты / dom-sim retry):
# SOFTGEN_QUALITY_REGEN_ENABLED=0
# SOFTGEN_CROSS_BUILD_MEMORY_ENABLED=0
# SOFTGEN_PROMPT_REGEN_ENABLED=0
# SOFTGEN_PROMPT_REWRITE_ENABLED=0
# Фиксированный lw-шаблон шапки/подвала (1); по умолчанию 0 — уникальный chrome от модели:
# SOFTGEN_TEMPLATE_CHROME=0
# Каталог блоків iGaming (підказки hero/секцій, без клону css); єдиний header/footer на сайт; 0 — вимкнути:
# SOFTGEN_PREMIUM_IGAMING_LAYOUT=1
# Повторы страницы при битом JSON / пустом ответе (по умолчанию 2 повтора = 3 запроса):
# SOFTGEN_PAGE_LAYOUT_MAX_RETRIES=2
# Повторы страницы при обрезанном mainHtml (по умолчанию 1):
# SOFTGEN_TRUNCATED_PAGE_RETRIES=1
# Якість тексту/SEO (за замовч. у instrumentation.ts: 0.88 і quality regen увімкнено):
# AURORA_GENERATION_TEMPERATURE=0.88
# SOFTGEN_QUALITY_REGEN_ENABLED=1
# Додаткові параметри збірки (як у soft-generator-new-v2):
# ANTHROPIC_MAX_TOKENS_ARCHITECT=24576
# AURORA_CLAUDE_SITE_OUTPUT_BUDGET=400000
# AURORA_GENERATION_TEMPERATURE=0.95
# SUPABASE_URL=   (те саме що NEXT_PUBLIC_SUPABASE_URL; для generation_prompt_profiles / generation_reference_sites)
# SUPABASE_SERVICE_ROLE_KEY=
# REDIS_URL=      (опційно: спільний стан job між інстансами)
# --- Per-account: /dashboard/settings | Серверний .env (усі інстанси): ---
# REDIS_URL, BUILD_JOBS_REDIS_URL, NEXT_PUBLIC_SUPABASE_*, SUPABASE_SERVICE_ROLE_KEY
# --- Per-account у settings (/dashboard/settings): ---
# Генератор: CLAUDE_API_KEY_01…10, ANTHROPIC_MODEL, ANTHROPIC_BASE_URL,
#   ANTHROPIC_MAX_TOKENS_PAGE, ANTHROPIC_MAX_TOKENS_ARCHITECT, AURORA_CLAUDE_SITE_OUTPUT_BUDGET,
#   SOFTGEN_MIN_PAGE_WORDS, SOFTGEN_MIN_INDEX_PAGE_WORDS, SOFTGEN_MAX_PAGE_WORDS,
#   AURORA_GENERATION_TEMPERATURE, SOFTGEN_QUALITY_REGEN_ENABLED
# Домени: SPACESHIP_*, ZOMRO_*, SSL_*, SUBDOMAIN_HOST_*
# SEO: YANDEX_XML_STOCK_BASE_URL | Telegram: TELEGRAM_* | auto-script: AUTOSCRIPT_*

# --- Купівля доменів (/dashboard/domain) ---
# SPACESHIP_API_KEY= SPACESHIP_API_SECRET= SPACESHIP_CONTACT_ID=
# ZOMRO_AUTH_TOKEN= ZOMRO_AUTH_THROUGH_KEY= ZOMRO_AUTHINFO=
# ZOMRO_USERNAME= ZOMRO_PASSWORD=
# ZOMRO_BILLMGR_URL= ZOMRO_BILLMGR_HOST= ZOMRO_BILLMGR_PORT= ZOMRO_BILLMGR_USE_HTTP=0
# ZOMRO_DNSMGR_URL= ZOMRO_DNSMGR_DOMAIN_EMAIL= ZOMRO_DNSMGR_ENABLED=1 ZOMRO_API_DNS_ENABLED=1
# ZOMRO_DNSMGR_TXT_CREATE_FUNC= ZOMRO_DNSMGR_TXT_DELETE_FUNC=
# SSL_LETSENCRYPT_EMAIL= SSL_LETSENCRYPT_STAGING=0 SSL_LETSENCRYPT_SKIP_VERIFY=0
# SSL_ASYNC_RETRY_MS=10000 SSL_MIN_AUTHORITATIVE_NS_READY=3
# SSL_DNS_CHALLENGE_REMOVE_DELAY_MS=120000 SSL_DELEGATION_WAIT_TIMEOUT_MS=600000
# SSL_DELEGATION_WAIT_POLL_MS=10000 SSL_ZOMRO_DNS_POST_DELAY_MS=90000
# SUBDOMAIN_HOST_IP= SUBDOMAIN_HOST_USER= SUBDOMAIN_HOST_PASSWORD= SUBDOMAIN_HOST_PORT=22
# SUBDOMAIN_HOST_SSL_DEPLOY=1 SUBDOMAIN_HOST_PROJECTS_DIR=/var/www
# SUBDOMAIN_HOST_NGINX_PHP=1 SUBDOMAIN_HOST_PHP_FPM_SOCKET=unix:/run/php/php8.1-fpm.sock

# --- SEO-панель (/dashboard/seo, API /api/seo/*) ---
# seo_domains, seo_keywords, seo_positions — supabase/migrations/*seo_user_scoped*
# YANDEX_XML_STOCK_BASE_URL=
# Telegram-бот (сповіщення клієнтам): TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_BOT_USERNAME
# Webhook: POST /api/seo/telegram-webhook (заголовок x-telegram-bot-api-secret-token)
# Привʼязка: Settings → Telegram → код → бот /start → мова → код
# TELEGRAM_* CRON_SECRET — cron очистки повідомлень
